---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
---
<Layout title={`Thanks | ${site.name}`} description="Your dumpster request was sent." noindex>
  <main id="main" class="ui-section">
    <div class="ui-container grid max-w-2xl justify-items-center gap-5 text-center">
      <p class="ui-eyebrow">Message sent</p>
      <h1 class="ui-h1">Request received.</h1>
      <p class="ui-lede">We'll call you to confirm your delivery, usually within a business day. If you need it sooner, call us at <a class="font-bold text-primary" href={site.contact.phoneTel}>{site.contact.phone}</a>.</p>
      <a class="ui-btn ui-btn--primary" href="/">Back to the home page</a>
    </div>
  </main>
</Layout>
