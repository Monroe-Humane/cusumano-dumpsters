---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../../../shared/components/PageHeader.astro';
import Icon from '../../../shared/components/Icon.astro';
import site from '../data/site.json';
---
<Layout title={`Thanks | ${site.name}`} description="Your dumpster request was sent." noindex>
  <Header />
  <main id="main">
    <PageHeader eyebrow="Request received" title="We'll call to confirm.">
      <p class="ui-lede">We'll call you to confirm your delivery, usually within a business day. If you need it sooner, call or text <a class="font-bold text-white underline" href={site.contact.phoneTel}>{site.contact.phone}</a>.</p>
      <div class="ui-actions mt-2">
        <a class="ui-btn ui-btn--accent" href="/">Back to the home page <Icon name="arrow" /></a>
      </div>
    </PageHeader>
  </main>
  <Footer />
</Layout>
