---
// Dumpster rentals: one page, one section per component. Text and prices live in data/site.json.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sizes from '../components/Sizes.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Materials from '../components/Materials.astro';
import Reserve from '../components/Reserve.astro';
import Faq from '../../../shared/components/Faq.astro';
import Reviews from '../../../shared/components/Reviews.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
---
<Layout>
  <Header />
  <main id="main">
    <Hero />
    <Sizes />
    <HowItWorks />
    <Materials />
    <Reviews reviews={site.reviews} title="Customers say it's easy" />
    <Faq items={site.faq} title="Dumpster rental questions">
      <span><a href={site.contact.phoneTel}>Call or text {site.contact.phone}</a>, or read the full <a href="/terms/">rental terms</a>.</span>
    </Faq>
    <Reserve />
  </main>
  <Footer cta={false} />
</Layout>
