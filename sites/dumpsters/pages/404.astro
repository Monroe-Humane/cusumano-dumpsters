---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
---
<Layout title={`Page not found | ${site.name}`} description="That page doesn't exist." noindex>
  <main id="main" class="ui-section">
    <div class="ui-container grid max-w-2xl justify-items-center gap-5 text-center">
      <p class="ui-eyebrow">404</p>
      <h1 class="ui-h1">That page isn't here.</h1>
      <p class="ui-lede">Sizes, prices and booking are all on our home page.</p>
      <a class="ui-btn ui-btn--primary" href="/">Go to the home page</a>
    </div>
  </main>
</Layout>
