---
import site from '../data/site.json';
import SectionHead from '../../../shared/components/SectionHead.astro';
---
<section class="ui-section ui-section--dark ui-blueprint" id="how" aria-labelledby="how-title">
  <div class="ui-container">
    <SectionHead id="how-title" eyebrow="How it works" title="Four easy steps" />
    <ol class="how__steps">
      {site.steps.map((step, i) => (
        <li class="how__step">
          <span class="how__num" aria-hidden="true">{i + 1}</span>
          <h3 class="ui-h3">{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how__steps { display: grid; gap: 1.25rem; margin: 0; padding: 0; list-style: none; counter-reset: none; }
  @media (min-width: 640px) { .how__steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .how__steps { grid-template-columns: repeat(4, 1fr); } }
  .how__step {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.03);
  }
  .how__step .ui-h3 { color: #fff; }
  .how__step p { margin: 0; color: #b9c6bb; }
  .how__num {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 10px;
    background: var(--color-accent-bright);
    color: var(--color-ink);
    font: 800 1.25rem/1 var(--font-display);
  }
</style>
