---
import { Picture } from 'astro:assets';
import site from '../data/site.json';
import Icon from '../../../shared/components/Icon.astro';
import delivered from '../assets/delivered-red.jpg';
const { hero, contact, reviews } = site;
---
<section class="hero ui-on-dark" id="top" aria-labelledby="hero-title">
  <Picture
    class="hero__bg"
    src={delivered}
    alt=""
    formats={['avif', 'webp']}
    widths={[640, 960, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="ui-container hero__grid">
    <div class="hero__inner">
      <a class="hero__rating" href={reviews.url} target="_blank" rel="noopener noreferrer">
        <span class="hero__stars" aria-hidden="true">★★★★★</span>
        <span><strong>{reviews.rating}</strong> from {reviews.count} Google reviews</span>
      </a>
      <h1 class="ui-h1" id="hero-title">Dumpster rentals <span class="ui-mark">dropped off fast.</span></h1>
      <p class="hero__copy">{hero.copy}</p>
      <div class="ui-actions">
        <a class="ui-btn ui-btn--accent" href="#reserve">Reserve a dumpster <Icon name="arrow" /></a>
        <a class="ui-btn ui-btn--light" href={contact.phoneTel}><Icon name="phone" /> {contact.phone}</a>
      </div>
      <ul class="hero__points">
        {site.highlights.map((h) => <li><Icon name="check" size={18} /> {h}</li>)}
      </ul>
    </div>

    <a class="hero__price" href="#sizes">
      <span>3-day rentals from</span>
      <strong>${hero.fromPrice}</strong>
      <span class="hero__price-link">See all sizes <Icon name="arrow" size={16} /></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(90vh, 760px);
    padding-block: clamp(4rem, 10vw, 7rem);
    background: var(--color-dark);
    color: #fff;
    overflow: hidden;
  }
  /* Astro puts the class on the <img> itself. */
  .hero :global(.hero__bg) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 65% 60%; }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(16 17 19 / 0.94) 0%, rgb(16 17 19 / 0.8) 40%, rgb(16 17 19 / 0.3) 75%, rgb(16 17 19 / 0.15) 100%);
  }
  @media (max-width: 760px) {
    .hero__shade { background: linear-gradient(180deg, rgb(16 17 19 / 0.6) 0%, rgb(16 17 19 / 0.88) 50%, rgb(16 17 19 / 0.96) 100%); }
  }
  .hero__grid { display: grid; gap: 2.5rem; align-items: end; }
  @media (min-width: 1000px) { .hero__grid { grid-template-columns: 1fr auto; } }
  .hero__inner { display: grid; gap: 1.5rem; justify-items: start; max-width: 680px; }
  .hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.18);
    backdrop-filter: blur(6px);
    color: #fff;
    font: 500 0.9rem/1.3 var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .hero__stars { color: var(--color-accent); letter-spacing: 0.08em; }
  .hero .ui-h1 { color: #fff; text-shadow: 0 2px 24px rgb(0 0 0 / 0.35); }
  .hero .ui-mark { display: block; }
  .hero__copy { margin: 0; font-size: clamp(1.1rem, 1.7vw, 1.3rem); line-height: 1.6; color: #dcdcd8; }
  .hero__points { display: grid; gap: 0.55rem 1.75rem; margin: 0; padding: 0; list-style: none; font-weight: 600; color: #e9e9e6; }
  @media (min-width: 560px) { .hero__points { grid-template-columns: 1fr 1fr; } }
  .hero__points li { display: flex; gap: 0.5rem; align-items: center; }
  .hero__points :global(svg) { flex: none; color: var(--color-accent); }

  .hero__price {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    justify-self: start;
    padding: 1.4rem 2rem;
    border-radius: var(--radius-card);
    background: var(--color-accent);
    color: var(--color-on-accent);
    text-decoration: none;
    box-shadow: 0 20px 50px -15px rgb(0 0 0 / 0.6);
    transform: rotate(-2deg);
    transition: transform 0.2s ease;
  }
  .hero__price:hover { transform: rotate(0deg) scale(1.03); }
  .hero__price span { font: 600 0.85rem/1.2 var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; }
  .hero__price strong { font: 700 4.4rem/0.95 var(--font-display); }
  .hero__price-link { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.35rem; padding-top: 0.5rem; border-top: 2px solid rgb(22 24 27 / 0.2); }
</style>
