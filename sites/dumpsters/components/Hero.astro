---
import site from '../data/site.json';
import { Picture } from 'astro:assets';
import Icon from '../../../shared/components/Icon.astro';
import delivered from '../assets/delivered-red.jpg';
const { hero, contact } = site;
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="ui-container hero__grid">
    <div class="hero__content">
      <p class="hero__label"><Icon name="trailer" size={18} /> {hero.label}</p>
      <h1 class="ui-h1" id="hero-title">{hero.title}</h1>
      <p class="ui-lede hero__copy">{hero.copy}</p>
      <div class="ui-actions">
        <a class="ui-btn ui-btn--accent" href="#reserve">Reserve a dumpster <Icon name="arrow" /></a>
        <a class="ui-btn ui-btn--outline" href={contact.phoneTel}><Icon name="phone" /> {contact.phone}</a>
      </div>
      <ul class="hero__points">
        {site.highlights.map((h) => <li><Icon name="check" size={18} /> {h}</li>)}
      </ul>
    </div>

    <figure class="hero__art">
      <Picture
        src={delivered}
        alt="A red Cusumano dump trailer delivered to a customer's driveway"
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 960px) 560px, 92vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="hero__price">
        <span>From</span>
        <strong>${hero.fromPrice}</strong>
        <span>3-day rental</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(3rem, 7vw, 5rem);
    background:
      radial-gradient(circle at 85% 10%, rgb(140 198 63 / 0.14), transparent 40%),
      radial-gradient(circle at 0% 0%, rgb(31 74 41 / 0.1), transparent 45%);
    overflow: hidden;
  }
  .hero__grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.05fr 1fr; } }
  .hero__content { display: grid; gap: 1.4rem; justify-items: start; }
  .hero__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--color-line);
    color: var(--color-primary);
    font: 700 0.85rem/1.3 var(--font-display);
  }
  .hero__copy { font-size: clamp(1.1rem, 1.6vw, 1.25rem); }
  .hero__points { display: grid; gap: 0.5rem 1.5rem; margin: 0; padding: 0; list-style: none; font-weight: 600; }
  @media (min-width: 520px) { .hero__points { grid-template-columns: 1fr 1fr; } }
  .hero__points li { display: flex; gap: 0.5rem; align-items: center; }
  .hero__points :global(svg) { flex: none; color: var(--color-accent); }

  .hero__art { position: relative; margin: 0; }
  .hero__art::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 3px solid var(--color-accent-bright);
    border-radius: 18px;
    z-index: -1;
  }
  .hero__art :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 30px 60px -20px rgb(18 28 21 / 0.45);
  }
  @media (max-width: 640px) { .hero__art::before { inset: 0.75rem -0.6rem -0.75rem 0.6rem; } }
  .hero__price {
    position: absolute;
    right: -0.75rem;
    top: -0.9rem;
    display: grid;
    justify-items: center;
    padding: 0.7rem 1.1rem;
    border-radius: 14px;
    background: var(--color-accent-bright);
    color: var(--color-ink);
    font: 700 0.78rem/1.2 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    box-shadow: var(--shadow-card);
  }
  .hero__price strong { font: 800 2.1rem/1 var(--font-display); letter-spacing: -0.02em; text-transform: none; }
  @media (max-width: 640px) { .hero__price { right: 0.5rem; } }
</style>
