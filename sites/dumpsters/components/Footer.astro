---
import site from '../data/site.json';
import Icon from '../../../shared/components/Icon.astro';
const year = new Date().getFullYear();
const { contact } = site;
---
<footer class="ui-section--dark site-footer">
  <div class="ui-container">
    <div class="site-footer__cta">
      <h2 class="ui-h2">Need it this week?</h2>
      <div class="ui-actions">
        <a class="ui-btn ui-btn--accent" href="/#reserve">Reserve a dumpster</a>
        <a class="ui-btn ui-btn--light" href={contact.phoneTel}><Icon name="phone" /> {contact.phone}</a>
      </div>
    </div>

    <div class="site-footer__grid">
      <div>
        <p class="site-footer__name">{site.name}</p>
        <p>A {site.legalName} business, serving {contact.areaServed}.</p>
      </div>
      <nav aria-label="Footer">
        <p class="site-footer__heading">Dumpsters</p>
        <ul>
          <li><a href="/#sizes">Sizes &amp; prices</a></li>
          <li><a href="/#materials">What can go in</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/terms/">Rental terms</a></li>
          <li><a href="/privacy/">Privacy policy</a></li>
        </ul>
      </nav>
      <div>
        <p class="site-footer__heading">Contact</p>
        <ul>
          <li>{contact.street}, {contact.city}, {contact.state} {contact.zip}</li>
          <li><a href={contact.phoneTel}>{contact.phone}</a></li>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a href={site.links.constructionSite}>Cusumano Home Improvements ↗</a></li>
        </ul>
      </div>
    </div>

    <p class="site-footer__legal">&copy; {year} {site.legalName}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(3rem, 7vw, 4.5rem) 2rem; }
  .site-footer__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .site-footer__cta .ui-h2 { color: #fff; }
  .site-footer__grid { display: grid; gap: 2rem; }
  @media (min-width: 768px) { .site-footer__grid { grid-template-columns: 1.3fr 1fr 1fr; } }
  .site-footer p, .site-footer li { margin: 0; color: #aebcb1; font-size: 0.98rem; }
  .site-footer__name { margin-bottom: 0.5rem !important; font: 800 1.2rem/1.3 var(--font-display); color: #fff !important; }
  .site-footer__heading { margin-bottom: 0.75rem !important; font: 700 0.8rem/1.3 var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent-bright) !important; }
  .site-footer ul { display: grid; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
  /* Plain links only: buttons in the footer keep their own colours. */
  .site-footer a:not(.ui-btn) { color: #e6eee7; text-decoration: none; }
  .site-footer a:not(.ui-btn):hover { color: #fff; text-decoration: underline; }
  .site-footer__legal { margin-top: 2.5rem !important; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.12); font-size: 0.88rem !important; }
</style>
