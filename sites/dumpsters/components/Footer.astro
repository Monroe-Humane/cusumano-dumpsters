---
import { Image, Picture } from 'astro:assets';
import site from '../data/site.json';
import Icon from '../../../shared/components/Icon.astro';
import logo from '../assets/logo.png';
import pair from '../assets/trailers-pair.jpg';

interface Props {
  /** Photo call-to-action band above the footer. Off on the home page, which ends with the form. */
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
const { contact } = site;
---
<footer class="site-footer">
  {cta && (
    <section class="cta ui-on-dark" aria-labelledby="cta-title">
      <Picture class="cta__bg" src={pair} alt="" formats={['avif', 'webp']} widths={[800, 1400]} sizes="100vw" loading="lazy" />
      <div class="ui-container cta__inner">
        <div>
          <p class="ui-eyebrow">Same-day drop-off available</p>
          <h2 class="ui-h2" id="cta-title">Need a dumpster <span class="ui-mark">this week?</span></h2>
        </div>
        <div class="ui-actions">
          <a class="ui-btn ui-btn--accent" href="/#reserve">Reserve a dumpster <Icon name="arrow" /></a>
          <a class="ui-btn ui-btn--light" href={contact.phoneTel}><Icon name="phone" /> {contact.phone}</a>
        </div>
      </div>
    </section>
  )}
  <div class="ui-hazard" aria-hidden="true"></div>

  <div class="site-footer__main">
    <div class="ui-container">
      <div class="site-footer__grid">
        <div class="site-footer__brand">
          <Image src={logo} alt={site.name} width={150} densities={[1, 2]} class="site-footer__logo" />
          <p>A {site.legalName} business, serving {contact.areaServed}. Residential and commercial.</p>
          <a class="site-footer__social" href={contact.facebook} target="_blank" rel="noopener noreferrer" aria-label="Cusumano on Facebook"><Icon name="facebook" size={20} /></a>
        </div>
        <nav aria-label="Footer">
          <p class="site-footer__heading">Dumpsters</p>
          <ul>
            <li><a href="/#sizes">Sizes &amp; prices</a></li>
            <li><a href="/#how">How it works</a></li>
            <li><a href="/#materials">What can go in</a></li>
            <li><a href="/#faq">FAQ</a></li>
            <li><a href="/terms/">Rental terms</a></li>
          </ul>
        </nav>
        <div>
          <p class="site-footer__heading">Contact</p>
          <ul>
            <li>{contact.street}<br />{contact.city}, {contact.state} {contact.zip}</li>
            <li><a href={contact.phoneTel}>{contact.phone}</a></li>
            <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><a href={site.links.constructionSite}>Cusumano Home Improvements ↗</a></li>
          </ul>
        </div>
      </div>

      <p class="site-footer__legal">
        <span>&copy; {year} {site.legalName}. All rights reserved.</span>
        <a href="/privacy/">Privacy policy</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .cta { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(4rem, 9vw, 6rem); background: var(--color-dark); }
  .cta :global(.cta__bg) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .cta::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(16 17 19 / 0.93), rgb(16 17 19 / 0.7)); }
  .cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.75rem 2.5rem; }
  .cta__inner > div:first-child { display: grid; gap: 1rem; }
  .cta .ui-h2 { color: #fff; }

  .site-footer__main { padding-block: clamp(3rem, 7vw, 4.5rem) 2rem; background: #101113; color: var(--color-on-dark-muted); }
  .site-footer__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 768px) { .site-footer__grid { grid-template-columns: 1.4fr 1fr 1fr; } }
  .site-footer__brand { display: grid; gap: 1rem; justify-items: start; }
  .site-footer__brand :global(.site-footer__logo) { display: block; height: auto; border-radius: 10px; }
  .site-footer p, .site-footer li { margin: 0; font-size: 0.98rem; }
  .site-footer__social { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 8px; border: 1px solid rgb(255 255 255 / 0.2); color: #fff; }
  .site-footer__social:hover { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
  .site-footer__heading { margin-bottom: 1rem !important; font: 600 0.85rem/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #fff; }
  .site-footer ul { display: grid; gap: 0.6rem; margin: 0; padding: 0; list-style: none; }
  .site-footer__main a:not(.ui-btn):not(.site-footer__social) { color: var(--color-on-dark); text-decoration: none; }
  .site-footer__main a:not(.ui-btn):not(.site-footer__social):hover { color: var(--color-accent); }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem !important;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.88rem !important;
  }
  .site-footer__legal a { text-decoration: underline !important; }
</style>
