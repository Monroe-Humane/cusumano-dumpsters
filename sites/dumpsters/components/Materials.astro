---
import site from '../data/site.json';
import Icon from '../../../shared/components/Icon.astro';
import SectionHead from '../../../shared/components/SectionHead.astro';
const { materials } = site;
---
<section class="ui-section" id="materials" aria-labelledby="materials-title">
  <div class="ui-container">
    <SectionHead
      id="materials-title"
      eyebrow="What goes in"
      title="What you can (and can't) toss"
      lede="Non-hazardous solid waste only. Load it evenly and no higher than the top edge."
    />

    <div class="mat__grid">
      <div class="ui-card mat__card mat__card--ok">
        <h3 class="ui-h3 mat__head mat__head--ok"><Icon name="check" /> Good to go</h3>
        <ul class="mat__list">{materials.allowed.map((m) => <li><Icon name="check" size={18} /> {m}</li>)}</ul>
      </div>
      <div class="ui-card mat__card mat__card--no">
        <h3 class="ui-h3 mat__head mat__head--no"><Icon name="ban" /> Not allowed</h3>
        <ul class="mat__list">{materials.prohibited.map((m) => <li><Icon name="close" size={18} /> {m}</li>)}</ul>
      </div>
    </div>
    <p class="mat__heavy"><Icon name="alert" /> <span>{materials.heavyNote}</span></p>

    <div class="mat__grid mat__grid--more" id="before">
      <div class="ui-card">
        <h3 class="ui-h3">Before we deliver</h3>
        <ul class="mat__checks">
          {site.placement.map((p) => <li><Icon name="check" size={18} /> {p}</li>)}
        </ul>
      </div>
      <div class="ui-card">
        <h3 class="ui-h3">Other fees</h3>
        <dl class="mat__fees">
          {site.fees.map((f) => (
            <div>
              <dt>{f.label}<span>{f.note}</span></dt>
              <dd>{f.amount}</dd>
            </div>
          ))}
        </dl>
        <a class="mat__terms" href="/terms/">Read the full rental terms →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .mat__grid { display: grid; gap: 1.5rem; }
  @media (min-width: 760px) { .mat__grid { grid-template-columns: 1fr 1fr; } }
  .mat__grid--more { margin-top: clamp(2rem, 4vw, 2.75rem); }
  .mat__card { padding-top: 0; overflow: hidden; }
  .mat__head { display: flex; align-items: center; gap: 0.65rem; margin: 0 calc(-1 * clamp(1.4rem, 3vw, 2rem)) 0.5rem !important; padding: 1.1rem clamp(1.4rem, 3vw, 2rem); }
  .mat__head--ok { background: var(--color-accent); color: var(--color-on-accent); }
  .mat__head--no { background: var(--color-dark); color: #fff; }
  .mat__head--no :global(svg) { color: #ff6b5e; }
  .mat__list { display: grid; gap: 0.7rem; margin: 0; padding: 0; list-style: none; font-weight: 600; }
  .mat__list li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .mat__list :global(svg) { flex: none; margin-top: 0.2rem; }
  .mat__card--ok .mat__list :global(svg) { color: var(--color-accent-ink); }
  .mat__card--no .mat__list :global(svg) { color: #b42318; }
  .mat__heavy {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin: 1.5rem 0 0;
    padding: 1.1rem 1.35rem;
    border-radius: 10px;
    background: #fff7e6;
    border-left: 5px solid #d97706;
    color: #5c3d07;
    font-weight: 600;
  }
  .mat__heavy :global(svg) { flex: none; margin-top: 0.15rem; color: #b45309; }

  .mat__checks { display: grid; gap: 0.7rem; margin: 0; padding: 0; list-style: none; }
  .mat__checks li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .mat__checks :global(svg) { flex: none; margin-top: 0.25rem; color: var(--color-accent-ink); }

  .mat__fees { display: grid; margin: 0; }
  .mat__fees div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.75rem 0; border-top: 1px solid var(--color-line); }
  .mat__fees div:first-child { border-top: 0; padding-top: 0; }
  .mat__fees dt { display: grid; font-weight: 600; }
  .mat__fees dt span { font-weight: 400; font-size: 0.9rem; color: var(--color-muted); }
  .mat__fees dd { margin: 0; white-space: nowrap; font: 700 1.3rem/1.3 var(--font-display); }
  .mat__terms { font: 600 0.95rem/1.2 var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink); }
  .mat__terms:hover { color: var(--color-accent-ink); }
</style>
