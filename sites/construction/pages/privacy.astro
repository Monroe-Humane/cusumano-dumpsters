---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrivacyPolicy from '../../../shared/components/PrivacyPolicy.astro';
import site from '../data/site.json';
const { contact } = site;
---
<Layout title={`Privacy Policy | ${site.name}`} description={`How ${site.name} handles information sent through this website.`}>
  <Header />
  <main id="main" class="ui-section">
    <PrivacyPolicy
      businessName={site.name}
      legalName="Cusumano Home Improvements LLC"
      email={contact.email}
      phone={contact.phone}
      phoneTel={contact.phoneTel}
      address={`${contact.street}, ${contact.city}, ${contact.state} ${contact.zip}`}
      formCollects="your name, phone number, optional email address, the service you're interested in and your project details"
      embeds={['Map. The contact section shows an embedded Google Map, which Google may use to set its own cookies. See Google\'s privacy policy for details.']}
      updated="October 2026"
    />
  </main>
  <Footer />
</Layout>
