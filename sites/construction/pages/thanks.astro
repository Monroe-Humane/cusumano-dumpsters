---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../../../shared/components/PageHeader.astro';
import Icon from '../../../shared/components/Icon.astro';
import site from '../data/site.json';
---
<Layout title={`Thanks | ${site.name}`} description="Your message was sent." noindex>
  <Header />
  <main id="main">
    <PageHeader eyebrow="Message sent" title="Thanks, we'll be in touch.">
      <p class="ui-lede">We usually reply within a business day. If it's urgent, call us at <a class="font-bold text-white underline" href={site.contact.phoneTel}>{site.contact.phone}</a>.</p>
      <div class="ui-actions mt-2">
        <a class="ui-btn ui-btn--accent" href="/">Back to the home page <Icon name="arrow" /></a>
      </div>
    </PageHeader>
  </main>
  <Footer />
</Layout>
