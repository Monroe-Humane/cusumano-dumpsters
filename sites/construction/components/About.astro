---
import { Picture } from 'astro:assets';
import site from '../data/site.json';
import Icon from '../../../shared/components/Icon.astro';
import { workPhoto } from '../lib/images';
const { about } = site;
---
<section class="ui-section" id="about" aria-labelledby="about-title">
  <div class="ui-container about">
    <div class="about__photos">
      <Picture
        class="about__main"
        src={workPhoto('porch-roof.jpg')}
        alt="New porch roof over a front stoop, built by Cusumano Home Improvements"
        formats={['avif', 'webp']}
        widths={[480, 800, 1100]}
        sizes="(min-width: 960px) 480px, 80vw"
        loading="lazy"
      />
      <Picture
        class="about__inset"
        src={workPhoto('raised-deck.jpg')}
        alt="Raised backyard deck with stairs"
        formats={['avif', 'webp']}
        widths={[320, 640]}
        sizes="(min-width: 960px) 260px, 45vw"
        loading="lazy"
      />
      <div class="about__badge">
        <span>Since</span>
        <strong>{site.foundedYear}</strong>
      </div>
    </div>

    <div class="about__text">
      <p class="ui-eyebrow">About us</p>
      <h2 class="ui-h2" id="about-title">{about.title}</h2>
      {about.paragraphs.map((p) => <p class="ui-lede">{p}</p>)}
      <ul class="about__points">
        {about.points.map((point) => (
          <li><span class="about__check"><Icon name="check" size={16} /></span>{point}</li>
        ))}
      </ul>
      <div class="ui-actions">
        <a class="ui-btn ui-btn--dark" href="#contact">Start your project <Icon name="arrow" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .about { display: grid; gap: clamp(3rem, 6vw, 5rem); align-items: center; }
  @media (min-width: 960px) { .about { grid-template-columns: 1fr 1.05fr; } }

  .about__photos { position: relative; padding: 0 12% 12% 0; }
  .about__photos :global(.about__main) { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-card); }
  .about__photos :global(.about__inset) {
    position: absolute;
    right: 0;
    bottom: 0;
    display: block;
    width: 48%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-card);
    border: 6px solid var(--color-paper);
    box-shadow: var(--shadow-lift);
  }
  .about__badge {
    position: absolute;
    top: 1.5rem;
    left: -0.75rem;
    display: grid;
    padding: 0.9rem 1.2rem;
    border-radius: 10px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: var(--shadow-lift);
  }
  .about__badge span { font: 500 0.8rem/1 var(--font-display); letter-spacing: 0.18em; text-transform: uppercase; }
  .about__badge strong { font: 700 2.6rem/1 var(--font-display); }

  .about__text { display: grid; gap: 1.25rem; }
  .about__points { display: grid; gap: 0.75rem 1.5rem; margin: 0.5rem 0; padding: 0; list-style: none; font-weight: 600; }
  @media (min-width: 560px) { .about__points { grid-template-columns: 1fr 1fr; } }
  .about__points li { display: flex; gap: 0.65rem; align-items: flex-start; }
  .about__check {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    margin-top: 0.05rem;
    border-radius: 6px;
    background: var(--color-dark);
    color: var(--color-accent);
  }
</style>
