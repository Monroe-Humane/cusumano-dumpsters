---
// The gold house from the Cusumano Home Improvements logo, redrawn as SVG.
interface Props { size?: number; class?: string }
const { size = 46, class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 64 56" height={size} width={Math.round(size * 64 / 56)} aria-hidden="true">
  <path d="M5 27 32 8l27 19" fill="none" stroke="#f5c518" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M44 15.5V9h7v11.5" fill="none" stroke="#f5c518" stroke-width="5" stroke-linejoin="round" />
  <path d="M13 24v26h38V24" fill="none" stroke="#f5c518" stroke-width="5" stroke-linejoin="round" />
</svg>
