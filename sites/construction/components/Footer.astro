---
import { Picture } from 'astro:assets';
import site from '../data/site.json';
import Icon from '../../../shared/components/Icon.astro';
import LogoMark from './LogoMark.astro';
import { workPhoto } from '../lib/images';
interface Props {
  /** Photo call-to-action band above the footer. Off on the home page, which ends with the form. */
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
const { contact } = site;
---
<footer class="site-footer">
  {cta && (
  <section class="cta ui-on-dark" aria-labelledby="cta-title">
    <Picture class="cta__bg" src={workPhoto('three-car-garage.jpg')} alt="" formats={['avif', 'webp']} widths={[800, 1400]} sizes="100vw" loading="lazy" />
    <div class="ui-container cta__inner">
      <div>
        <p class="ui-eyebrow">Free estimates</p>
        <h2 class="ui-h2" id="cta-title">Ready to start <span class="ui-mark">your project?</span></h2>
      </div>
      <div class="ui-actions">
        <a class="ui-btn ui-btn--accent" href="/#contact">Get a free estimate <Icon name="arrow" /></a>
        <a class="ui-btn ui-btn--light" href={contact.phoneTel}><Icon name="phone" /> {contact.phone}</a>
      </div>
    </div>
  </section>
  )}
  <div class="ui-hazard" aria-hidden="true"></div>

  <div class="site-footer__main">
    <div class="ui-container">
      <div class="site-footer__grid">
        <div class="site-footer__brand">
          <a href="/#top" class="site-footer__logo">
            <LogoMark size={44} />
            <span><strong>Cusumano</strong><small>Home Improvements LLC</small></span>
          </a>
          <p>Family-owned and operated in {contact.city}, Michigan since {site.foundedYear}. Licensed and insured.</p>
          <a class="site-footer__social" href={contact.facebook} target="_blank" rel="noopener noreferrer" aria-label="Cusumano Home Improvements on Facebook"><Icon name="facebook" size={20} /></a>
        </div>
        <nav aria-label="Footer">
          <p class="site-footer__heading">Services</p>
          <ul>
            {site.serviceGroups.map((g) => <li><a href="/#services">{g.title}</a></li>)}
            <li><a href={site.links.dumpsterSite}>Dumpster Rentals ↗</a></li>
          </ul>
        </nav>
        <div>
          <p class="site-footer__heading">Contact</p>
          <ul>
            <li>{contact.street}<br />{contact.city}, {contact.state} {contact.zip}</li>
            <li><a href={contact.phoneTel}>{contact.phone}</a></li>
            <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li>Serving {contact.areaServed.join(', ')}</li>
          </ul>
        </div>
      </div>

      <p class="site-footer__legal">
        <span>&copy; {year} {site.name} LLC. All rights reserved.</span>
        <a href="/privacy/">Privacy policy</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .cta { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(4rem, 9vw, 6rem); background: var(--color-dark); }
  .cta :global(.cta__bg) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .cta::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(16 17 19 / 0.92), rgb(16 17 19 / 0.7)); }
  .cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.75rem 2.5rem; }
  .cta__inner > div:first-child { display: grid; gap: 1rem; }
  .cta .ui-h2 { color: #fff; }

  .site-footer__main { padding-block: clamp(3rem, 7vw, 4.5rem) 2rem; background: #101113; color: var(--color-on-dark-muted); }
  .site-footer__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 768px) { .site-footer__grid { grid-template-columns: 1.4fr 1fr 1fr; } }
  .site-footer__brand { display: grid; gap: 1rem; justify-items: start; }
  .site-footer__logo { display: flex; align-items: center; gap: 0.75rem; color: #fff; text-decoration: none; }
  .site-footer__logo span { display: grid; line-height: 1.05; }
  .site-footer__logo strong { font: 700 1.6rem/1 var(--font-display); letter-spacing: 0.04em; text-transform: uppercase; }
  .site-footer__logo small { font: 500 0.75rem/1.4 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent); }
  .site-footer p, .site-footer li { margin: 0; font-size: 0.98rem; }
  .site-footer__social { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 8px; border: 1px solid rgb(255 255 255 / 0.2); color: #fff; }
  .site-footer__social:hover { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
  .site-footer__heading { margin-bottom: 1rem !important; font: 600 0.85rem/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: #fff; }
  .site-footer ul { display: grid; gap: 0.6rem; margin: 0; padding: 0; list-style: none; }
  .site-footer__main a:not(.ui-btn):not(.site-footer__logo):not(.site-footer__social) { color: var(--color-on-dark); text-decoration: none; }
  .site-footer__main a:not(.ui-btn):not(.site-footer__logo):not(.site-footer__social):hover { color: var(--color-accent); }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem !important;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.88rem !important;
  }
  .site-footer__legal a { text-decoration: underline !important; }
</style>
