---
import { Picture, Image } from 'astro:assets';
import site from '../data/site.json';
import Icon from '../../../shared/components/Icon.astro';
import SectionHead from '../../../shared/components/SectionHead.astro';
import { workPhoto } from '../lib/images';
import dumpsterLogo from '../../dumpsters/assets/logo.png';
---
<section class="ui-section services" id="services" aria-labelledby="services-title">
  <div class="ui-container">
    <SectionHead
      id="services-title"
      eyebrow="What we build"
      title="Built for the way you live"
      lede="Garages, porches, concrete and more, from one local family crew, from the first estimate to the last cleanup."
    />

    <div class="services__grid">
      {site.serviceGroups.map((g, i) => (
        <article class="svc">
          <div class="svc__media">
            <Picture
              src={workPhoto(g.image)}
              alt=""
              formats={['avif', 'webp']}
              widths={[480, 720, 1000]}
              sizes="(min-width: 760px) 580px, 92vw"
              loading="lazy"
            />
            <span class="svc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="svc__body">
            <h3 class="ui-h3">{g.title}</h3>
            <p>{g.text}</p>
            <ul class="ui-tags" aria-label={`${g.title} services`}>
              {g.services.map((s) => <li>{s}</li>)}
            </ul>
            <a class="svc__link" href="#contact">Get a quote <Icon name="arrow" size={18} /></a>
          </div>
        </article>
      ))}
    </div>

    <aside class="dumpster ui-on-dark ui-blueprint" aria-labelledby="dumpster-title">
      <Image src={dumpsterLogo} alt="Cusumano Dumpster Rentals" width={130} densities={[1, 2]} class="dumpster__logo" />
      <div class="dumpster__text">
        <p class="ui-eyebrow">Sister business</p>
        <h3 class="ui-h3" id="dumpster-title">{site.dumpsters.title}</h3>
        <p>{site.dumpsters.text}</p>
      </div>
      <a class="ui-btn ui-btn--accent" href={site.links.dumpsterSite}>{site.dumpsters.linkLabel} <Icon name="arrow" /></a>
    </aside>
  </div>
</section>

<style>
  .services { padding-top: clamp(5rem, 10vw, 7.5rem); }
  .services__grid { display: grid; gap: 1.5rem; }
  @media (min-width: 760px) { .services__grid { grid-template-columns: repeat(2, 1fr); } }

  .svc {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #fff;
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-card);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .svc:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .svc__media { position: relative; overflow: hidden; aspect-ratio: 16 / 10; background: var(--color-dark); }
  .svc__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .svc:hover .svc__media :global(img) { transform: scale(1.05); }
  .svc__num {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.55rem 1rem 0.4rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font: 700 1.5rem/1 var(--font-display);
  }
  .svc__body { display: flex; flex: 1; flex-direction: column; gap: 0.85rem; padding: clamp(1.4rem, 3vw, 1.9rem); }
  .svc__body p { margin: 0; color: var(--color-muted); }
  .svc__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--color-ink);
    font: 600 0.95rem/1.2 var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .svc__link :global(svg) { color: var(--color-accent-ink); transition: transform 0.2s ease; }
  .svc__link:hover :global(svg) { transform: translateX(4px); }

  .dumpster {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 1.5rem;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    border-radius: var(--radius-card);
    background-color: var(--color-dark);
    color: var(--color-on-dark);
  }
  .dumpster :global(.dumpster__logo) { flex: none; height: auto; border-radius: 10px; }
  .dumpster__text { flex: 1 1 300px; display: grid; gap: 0.5rem; }
  .dumpster__text .ui-h3 { color: #fff; }
  .dumpster__text p:not(.ui-eyebrow) { margin: 0; color: var(--color-on-dark-muted); }
</style>
