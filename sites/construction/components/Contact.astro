---
import site from '../data/site.json';
import Icon from '../../../shared/components/Icon.astro';
import SectionHead from '../../../shared/components/SectionHead.astro';
const { contact } = site;
// FormSubmit sends each message to the inbox in formAction, then returns the visitor to /thanks/.
const thanksUrl = new URL('/thanks/', Astro.site).href;
---
<section class="ui-section ui-section--dark ui-blueprint contact" id="contact" aria-labelledby="contact-title">
  <div class="ui-container contact__grid">
    <div class="contact__info">
      <SectionHead
        id="contact-title"
        eyebrow="Free estimates"
        title="Let's talk about your project"
        lede="Tell us what you have in mind and we'll get back to you, usually within a business day. Prefer the phone? Call anytime."
      />

      <ul class="contact__list">
        <li>
          <span class="ui-icon-badge"><Icon name="phone" /></span>
          <div><span class="contact__k">Call or text</span><a href={contact.phoneTel}>{contact.phone}</a></div>
        </li>
        <li>
          <span class="ui-icon-badge"><Icon name="mail" /></span>
          <div><span class="contact__k">Email</span><a href={`mailto:${contact.email}`}>{contact.email}</a></div>
        </li>
        <li>
          <span class="ui-icon-badge"><Icon name="pin" /></span>
          <div><span class="contact__k">Address</span><a href={contact.mapLink} target="_blank" rel="noopener noreferrer">{contact.street}, {contact.city}, {contact.state} {contact.zip}</a></div>
        </li>
      </ul>

      <div class="contact__map">
        <iframe
          src={contact.mapEmbed}
          title="Map showing Cusumano Home Improvements in Monroe, Michigan"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>

    <form class="ui-card contact__form" action={contact.formAction} method="POST" data-contact-form>
      <h3 class="ui-h3">Request a free estimate</h3>
      <p class="contact__sub">Takes about a minute. No obligation.</p>
      <input type="hidden" name="_subject" value="New estimate request from cusumanohi.com" />
      <input type="hidden" name="_next" value={thanksUrl} />
      <input type="hidden" name="_template" value="table" />
      <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="ui-field">
        <label for="f-name">Name</label>
        <input class="ui-input" id="f-name" name="name" type="text" autocomplete="name" required minlength="2" />
      </div>
      <div class="contact__row">
        <div class="ui-field">
          <label for="f-phone">Phone</label>
          <input class="ui-input" id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
        </div>
        <div class="ui-field">
          <label for="f-email">Email <span class="ui-optional">(optional)</span></label>
          <input class="ui-input" id="f-email" name="email" type="email" autocomplete="email" />
        </div>
      </div>
      <div class="ui-field">
        <label for="f-service">What do you need?</label>
        <select class="ui-input" id="f-service" name="service">
          <option value="">Choose one (optional)</option>
          {site.serviceGroups.map((g) => <option>{g.title}</option>)}
          <option>Something else</option>
        </select>
      </div>
      <div class="ui-field">
        <label for="f-message">Project details</label>
        <textarea class="ui-input" id="f-message" name="message" required minlength="10" placeholder="Size, timing, address or anything else that helps"></textarea>
      </div>
      <button class="ui-btn ui-btn--accent w-full" type="submit" data-submit>Send request <Icon name="arrow" /></button>
      <p class="contact__fine">We only use your details to reply about your project. <a href="/privacy/">Privacy policy</a></p>
    </form>
  </div>
</section>

<style>
  .contact__grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: start; }
  @media (min-width: 960px) { .contact__grid { grid-template-columns: 1fr 1fr; } }
  .contact__info :global(.ui-section-head) { margin-bottom: 2rem; }
  .contact__info :global(.ui-h2) { color: #fff; }

  .contact__list { display: grid; gap: 1.1rem; margin: 0 0 2rem; padding: 0; list-style: none; }
  .contact__list li { display: flex; gap: 1rem; align-items: center; }
  .contact__list :global(.ui-icon-badge) { background: var(--color-accent); color: var(--color-on-accent); }
  .contact__list div { display: grid; }
  .contact__k { font: 500 0.78rem/1.3 var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-on-dark-muted); }
  .contact__list a { font: 600 1.3rem/1.3 var(--font-display); letter-spacing: 0.02em; color: #fff; text-decoration: none; overflow-wrap: anywhere; }
  .contact__list a:hover { color: var(--color-accent); }

  .contact__map { overflow: hidden; border-radius: var(--radius-card); border: 1px solid rgb(255 255 255 / 0.12); background: var(--color-dark-2); }
  .contact__map iframe { display: block; width: 100%; height: 280px; border: 0; filter: grayscale(0.35) contrast(1.05); }

  .contact__form { gap: 1.15rem; border: 0; border-top: 6px solid var(--color-accent); box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.5); }
  .contact__form .ui-h3 { font-size: 1.6rem; }
  .contact__sub { margin-top: -0.6rem !important; }
  .contact__row { display: grid; gap: 1.15rem; }
  @media (min-width: 560px) { .contact__row { grid-template-columns: 1fr 1fr; } }
  .contact__fine { font-size: 0.88rem; text-align: center; }
  .contact__fine a { color: var(--color-ink); font-weight: 600; text-decoration: underline; }
</style>

<script>
  // Stop double submits while FormSubmit is loading.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', () => {
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]');
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Sending…';
    }
  });
</script>
