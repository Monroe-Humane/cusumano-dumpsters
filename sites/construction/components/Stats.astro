---
import site from '../data/site.json';
---
<!-- Overlaps the bottom of the hero photo. -->
<section class="stats" aria-label="Why homeowners choose Cusumano">
  <div class="ui-container">
    <dl class="stats__card">
      {site.stats.map((s) => (
        <div class="stats__item">
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats { position: relative; z-index: 2; margin-top: clamp(-5rem, -9vw, -4rem); }
  .stats__card {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #fff;
    box-shadow: var(--shadow-lift);
  }
  @media (min-width: 820px) { .stats__card { grid-template-columns: repeat(4, 1fr); } }
  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
    padding: clamp(1.25rem, 3vw, 1.9rem) clamp(1rem, 2.5vw, 1.75rem);
    border-top: 4px solid var(--color-accent);
    border-right: 1px solid var(--color-line);
  }
  .stats__item:nth-child(2n) { border-right: 0; }
  @media (min-width: 820px) {
    .stats__item:nth-child(2n) { border-right: 1px solid var(--color-line); }
    .stats__item:last-child { border-right: 0; }
  }
  .stats__item dd { margin: 0; font: 700 clamp(2rem, 4.5vw, 2.9rem)/1 var(--font-display); color: var(--color-ink); }
  .stats__item dt { font: 500 0.82rem/1.35 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-muted); }
</style>
