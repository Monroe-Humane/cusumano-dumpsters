---
import SiteHeader from '../../../shared/components/SiteHeader.astro';
import LogoMark from './LogoMark.astro';
import site from '../data/site.json';

const links = [
  { href: '/#services', label: 'Services' },
  { href: '/#work', label: 'Our Work' },
  { href: '/#about', label: 'About' },
  { href: '/#reviews', label: 'Reviews' },
  { href: '/#faq', label: 'FAQ' },
  { href: site.links.dumpsterSite, label: 'Dumpsters' },
];
---
<SiteHeader
  name="Cusumano"
  sub="Home Improvements LLC"
  label={site.name}
  links={links}
  phone={site.contact.phone}
  phoneTel={site.contact.phoneTel}
  menuCta={{ href: '/#contact', label: 'Get a free estimate' }}
>
  <LogoMark />
</SiteHeader>
