---
import { Picture, getImage } from 'astro:assets';
import site from '../data/site.json';
import Icon from '../../../shared/components/Icon.astro';
import SectionHead from '../../../shared/components/SectionHead.astro';
import { workPhoto } from '../lib/images';

// Mosaic rhythm: the first photo is large, every fourth after it spans two columns. If the
// cells don't fill whole rows of four, the last photo widens so the grid has no hole.
const count = site.gallery.length;
const baseSpan = (i: number) => (i === 0 ? 'big' : i % 4 === 3 ? 'wide' : '');
const cells = site.gallery.reduce((n, _, i) => n + ({ big: 4, wide: 2, '': 1 } as const)[baseSpan(i)], 0);
const span = (i: number) => (i === count - 1 && cells % 4 !== 0 && baseSpan(i) === '' ? 'wide' : baseSpan(i));

// Full-size versions for the lightbox (built at 1600px, served as WebP).
const slides = await Promise.all(
  site.gallery.map(async (item) => {
    const full = await getImage({ src: workPhoto(item.image), width: 1600, format: 'webp' });
    return { src: full.src, title: item.title, tag: item.tag };
  }),
);
---
<section class="ui-section ui-section--dark ui-blueprint" id="work" aria-labelledby="work-title">
  <div class="ui-container">
    <div class="work__head">
      <SectionHead
        id="work-title"
        eyebrow="Our work"
        title="Recent projects around Monroe"
        lede="Garages, porches, decks and outbuildings we've built for neighbors. Tap any photo to see it full size."
      />
      <a class="ui-btn ui-btn--light" href={site.contact.facebook} target="_blank" rel="noopener noreferrer">
        <Icon name="facebook" /> More on Facebook
      </a>
    </div>

    <ul class="mosaic">
      {site.gallery.map((item, i) => (
        <li class:list={['mosaic__item', span(i) && `mosaic__item--${span(i)}`]}>
          <button type="button" class="mosaic__btn" data-open={i}>
            <Picture
              src={workPhoto(item.image)}
              alt=""
              formats={['avif', 'webp']}
              widths={[400, 700, 1100]}
              sizes={i === 0 ? '(min-width: 900px) 600px, 92vw' : '(min-width: 900px) 300px, 46vw'}
              loading={i < 3 ? 'eager' : 'lazy'}
            />
            <span class="mosaic__cap">
              <span class="mosaic__tag">{item.tag}</span>
              <span class="mosaic__title">{item.title}</span>
              <span class="sr-only">(view full size)</span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="lightbox" data-lightbox data-slides={JSON.stringify(slides)} aria-label="Project photo viewer">
    <figure class="lightbox__fig">
      <img data-lb-img alt="" />
      <figcaption>
        <span class="lightbox__tag" data-lb-tag></span>
        <span class="lightbox__title" data-lb-title></span>
        <span class="lightbox__count" data-lb-count></span>
      </figcaption>
    </figure>
    <button type="button" class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Previous photo"><Icon name="chevronLeft" size={28} /></button>
    <button type="button" class="lightbox__nav lightbox__nav--next" data-lb-next aria-label="Next photo"><Icon name="chevronRight" size={28} /></button>
    <button type="button" class="lightbox__close" data-lb-close aria-label="Close"><Icon name="close" size={26} /></button>
  </dialog>
</section>

<style>
  .work__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.25rem 2rem; margin-bottom: clamp(2.25rem, 5vw, 3.5rem); }
  .work__head :global(.ui-section-head) { margin-bottom: 0; }
  .work__head :global(.ui-h2) { color: #fff; }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 170px;
    grid-auto-flow: dense;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) { .mosaic { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 210px; gap: 1rem; } }
  .mosaic__item--big { grid-column: span 2; grid-row: span 2; }
  .mosaic__item--wide { grid-column: span 2; }
  .mosaic__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-dark-2);
    cursor: zoom-in;
  }
  .mosaic__btn :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .mosaic__btn:hover :global(img), .mosaic__btn:focus-visible :global(img) { transform: scale(1.06); }
  .mosaic__cap {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.1rem;
    padding: 2.5rem 1rem 0.85rem;
    background: linear-gradient(transparent, rgb(10 11 13 / 0.88));
    text-align: left;
  }
  .mosaic__tag { font: 500 0.72rem/1.3 var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); }
  .mosaic__title { font: 600 1.05rem/1.2 var(--font-display); letter-spacing: 0.03em; text-transform: uppercase; color: #fff; }
  .mosaic__item--big .mosaic__title { font-size: 1.5rem; }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(8 9 10 / 0.96);
    color: #fff;
    overscroll-behavior: contain;
  }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.6); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox__fig { display: grid; justify-items: center; gap: 1rem; margin: 0; padding: 4rem 1rem 1.5rem; max-width: 100%; }
  .lightbox__fig img { max-width: min(92vw, 1400px); max-height: calc(100dvh - 10rem); width: auto; height: auto; border-radius: 6px; object-fit: contain; }
  .lightbox__fig figcaption { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 0.25rem 1rem; text-align: center; }
  .lightbox__tag { font: 500 0.8rem/1.3 var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); }
  .lightbox__title { font: 600 1.3rem/1.2 var(--font-display); letter-spacing: 0.03em; text-transform: uppercase; }
  .lightbox__count { font-size: 0.9rem; color: #9a9ea4; }
  .lightbox__nav, .lightbox__close {
    position: fixed;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1.5px solid rgb(255 255 255 / 0.3);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.06);
    color: #fff;
    cursor: pointer;
  }
  .lightbox__nav:hover, .lightbox__close:hover { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
  .lightbox__nav { top: 50%; transform: translateY(-50%); }
  .lightbox__nav--prev { left: max(0.75rem, 2vw); }
  .lightbox__nav--next { right: max(0.75rem, 2vw); }
  .lightbox__close { top: 1rem; right: 1rem; }
  @media (max-width: 640px) {
    .lightbox__nav { top: auto; bottom: 1rem; transform: none; }
    .lightbox__fig { padding-bottom: 5.5rem; }
  }
</style>

<script>
  type Slide = { src: string; title: string; tag: string };
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const slides: Slide[] = JSON.parse(dialog.dataset.slides || '[]');
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const tag = dialog.querySelector<HTMLElement>('[data-lb-tag]')!;
    const title = dialog.querySelector<HTMLElement>('[data-lb-title]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      const s = slides[index];
      img.src = s.src;
      img.alt = `${s.title} built by Cusumano Home Improvements`;
      tag.textContent = s.tag;
      title.textContent = s.title;
      count.textContent = `${index + 1} / ${slides.length}`;
      // Warm the next photo so arrowing through feels instant.
      new Image().src = slides[(index + 1) % slides.length].src;
    };

    document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        opener = btn;
        show(Number(btn.dataset.open));
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener?.focus());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // Click on the dark area (not the photo or buttons) closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('lightbox__fig')) dialog.close();
    });
    // Swipe left/right on touch screens.
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(dx < 0 ? index + 1 : index - 1);
    }, { passive: true });
  }
</script>
