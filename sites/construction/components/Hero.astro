---
import { Picture } from 'astro:assets';
import site from '../data/site.json';
import Icon from '../../../shared/components/Icon.astro';
import { workPhoto } from '../lib/images';
const { hero, contact, reviews } = site;
---
<section class="hero ui-on-dark" id="top" aria-labelledby="hero-title">
  <Picture
    class="hero__bg"
    src={workPhoto(hero.image)}
    alt=""
    formats={['avif', 'webp']}
    widths={[640, 960, 1460]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="ui-container hero__inner">
    <a class="hero__rating" href={reviews.url} target="_blank" rel="noopener noreferrer">
      <span class="hero__stars" aria-hidden="true">★★★★★</span>
      <span><strong>{reviews.rating}</strong> from {reviews.count} Google reviews</span>
    </a>
    <h1 class="ui-h1 hero__title" id="hero-title">
      {hero.title} <span class="ui-mark">{hero.titleMark}</span>
    </h1>
    <p class="hero__copy">{hero.copy}</p>
    <div class="ui-actions">
      <a class="ui-btn ui-btn--accent" href="#contact">Get a free estimate <Icon name="arrow" /></a>
      <a class="ui-btn ui-btn--light" href={contact.phoneTel}><Icon name="phone" /> {contact.phone}</a>
    </div>
    <p class="hero__area"><Icon name="pin" size={18} /> Serving {contact.areaServed.join(', ')} and nearby</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(92vh, 780px);
    padding-block: clamp(4rem, 10vw, 7rem) clamp(7rem, 14vw, 9rem);
    background: var(--color-dark);
    color: #fff;
    overflow: hidden;
  }
  /* Astro puts the class on the <img> itself. */
  .hero :global(.hero__bg) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(16 17 19 / 0.92) 0%, rgb(16 17 19 / 0.78) 38%, rgb(16 17 19 / 0.25) 75%, rgb(16 17 19 / 0.1) 100%),
      linear-gradient(0deg, rgb(16 17 19 / 0.6) 0%, transparent 35%);
  }
  @media (max-width: 760px) {
    .hero__shade { background: linear-gradient(180deg, rgb(16 17 19 / 0.55) 0%, rgb(16 17 19 / 0.85) 55%, rgb(16 17 19 / 0.95) 100%); }
  }
  .hero__inner { display: grid; gap: 1.5rem; justify-items: start; }
  .hero__inner > * { max-width: 660px; }
  .hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.18);
    backdrop-filter: blur(6px);
    color: #fff;
    font: 500 0.9rem/1.3 var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .hero__rating:hover { background: rgb(255 255 255 / 0.18); }
  .hero__stars { color: var(--color-accent); letter-spacing: 0.08em; }
  .hero__title { color: #fff; text-shadow: 0 2px 24px rgb(0 0 0 / 0.35); }
  .hero__title .ui-mark { display: block; }
  .hero__copy { margin: 0; font-size: clamp(1.1rem, 1.7vw, 1.3rem); line-height: 1.6; color: #dcdcd8; }
  .hero__area { display: flex; gap: 0.5rem; align-items: center; margin: 0; color: #c9cac6; font-size: 0.98rem; }
  .hero__area :global(svg) { flex: none; color: var(--color-accent); }
</style>
