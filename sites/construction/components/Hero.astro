---
import site from '../data/site.json';
import { Picture } from 'astro:assets';
import Icon from '../../../shared/components/Icon.astro';
import { workPhoto } from '../lib/images';
const { hero, contact } = site;
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="ui-container hero__grid">
    <div class="hero__content">
      <p class="hero__label"><Icon name="shield" size={18} /> {hero.label}</p>
      <h1 class="ui-h1" id="hero-title">{hero.title}</h1>
      <p class="ui-lede hero__copy">{hero.copy}</p>
      <div class="ui-actions">
        <a class="ui-btn ui-btn--accent" href="#contact">Get a free estimate <Icon name="arrow" /></a>
        <a class="ui-btn ui-btn--outline" href={contact.phoneTel}><Icon name="phone" /> {contact.phone}</a>
      </div>
      <p class="hero__area">
        <Icon name="pin" size={18} />
        Serving {contact.areaServed.join(', ')} and nearby communities
      </p>
    </div>

    <figure class="hero__media">
      <Picture
        src={workPhoto(hero.image)}
        alt={hero.imageAlt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1460]}
        sizes="(min-width: 960px) 560px, 92vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="hero__badge">
        <strong>{new Date().getFullYear() - site.foundedYear}+</strong>
        <span>years building<br />in Monroe County</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(3rem, 7vw, 5.5rem);
    background:
      radial-gradient(circle at 85% 10%, rgb(249 115 22 / 0.09), transparent 40%),
      radial-gradient(circle at 0% 0%, rgb(31 58 90 / 0.1), transparent 45%);
    overflow: hidden;
  }
  .hero__grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.05fr 1fr; } }

  .hero__content { display: grid; gap: 1.4rem; justify-items: start; }
  .hero__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--color-line);
    color: var(--color-primary);
    font: 700 0.85rem/1.3 var(--font-display);
  }
  .hero__copy { font-size: clamp(1.1rem, 1.6vw, 1.25rem); }
  .hero__area { display: flex; gap: 0.5rem; align-items: flex-start; margin: 0; color: var(--color-muted); font-size: 0.95rem; }
  .hero__area :global(svg) { flex: none; margin-top: 0.2rem; color: var(--color-accent); }

  .hero__media { position: relative; margin: 0; }
  .hero__media::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 3px solid var(--color-accent-bright);
    border-radius: 18px;
    z-index: -1;
  }
  .hero__media :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 30px 60px -20px rgb(17 26 37 / 0.45);
  }
  .hero__badge {
    position: absolute;
    left: -0.75rem;
    bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    border-radius: 14px;
    background: #fff;
    box-shadow: var(--shadow-card);
    font: 600 0.85rem/1.25 var(--font-display);
    color: var(--color-muted);
  }
  .hero__badge strong { font: 800 2rem/1 var(--font-display); color: var(--color-primary); }
  @media (max-width: 640px) {
    .hero__media::before { inset: 0.75rem -0.6rem -0.75rem 0.6rem; }
    .hero__badge { left: 0.75rem; bottom: 0.75rem; }
  }
</style>
