---
// Expand/collapse FAQ list. The default slot is the line under the list ("Don't see your question?").
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'Questions we hear a lot' } = Astro.props;
---
<section class="ui-section ui-section--tint" id="faq" aria-labelledby="faq-title">
  <div class="ui-container faq__wrap">
    <SectionHead id="faq-title" eyebrow="FAQ" title={title} center />
    <div class="faq__list">
      {items.map((f) => (
        <details class="faq__item" name="faq">
          <summary>
            <span>{f.q}</span>
            <span class="faq__icon"><Icon name="plus" size={20} /></span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="faq__more"><slot /></p>
  </div>
</section>

<style>
  .faq__wrap { max-width: 820px; }
  .faq__list { display: grid; gap: 0.75rem; }
  .faq__item { background: #fff; border: 1px solid var(--color-line); border-radius: 12px; }
  .faq__item[open] { border-color: var(--color-primary); box-shadow: var(--shadow-card); }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    font: 700 1.08rem/1.35 var(--font-display);
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }
  .faq__item[open] .faq__icon { transform: rotate(45deg); background: var(--color-accent); color: #fff; }
  .faq__item p { margin: 0; padding: 0 1.25rem 1.25rem; color: var(--color-muted); }
  .faq__more { margin: 1.75rem 0 0; text-align: center; color: var(--color-muted); }
  .faq__more :global(a) { color: var(--color-primary); font-weight: 600; }
</style>
