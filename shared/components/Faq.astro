---
// Expand/collapse FAQ list, with the heading and a "still have questions" card beside it on
// wide screens. The default slot is that card's text (e.g. "Call 734-… or send a message").
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'Questions we hear a lot' } = Astro.props;
---
<section class="ui-section" id="faq" aria-labelledby="faq-title">
  <div class="ui-container faq">
    <div class="faq__side">
      <SectionHead id="faq-title" eyebrow="FAQ" title={title} />
      <div class="faq__more ui-on-dark">
        <span class="faq__more-icon"><Icon name="message" /></span>
        <p><strong>Still have a question?</strong><slot /></p>
      </div>
    </div>
    <div class="faq__list">
      {items.map((f) => (
        <details class="faq__item" name="faq">
          <summary>
            <span>{f.q}</span>
            <span class="faq__icon"><Icon name="plus" size={20} /></span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (min-width: 960px) {
    .faq { grid-template-columns: 0.85fr 1.15fr; }
    .faq__side { position: sticky; top: calc(var(--header-h, 72px) + 2rem); }
  }
  .faq__side :global(.ui-section-head) { margin-bottom: 1.75rem; }
  .faq__more {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius-card);
    background: var(--color-dark);
    color: var(--color-on-dark-muted);
  }
  .faq__more p { display: grid; gap: 0.3rem; margin: 0; }
  .faq__more strong { font: 600 1.15rem/1.2 var(--font-display); letter-spacing: 0.04em; text-transform: uppercase; color: #fff; }
  .faq__more :global(a) { color: var(--color-accent); font-weight: 700; }
  .faq__more-icon { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 10px; background: var(--color-accent); color: var(--color-on-accent); }

  .faq__list { display: grid; gap: 0.75rem; }
  .faq__item { background: #fff; border: 1px solid var(--color-line); border-radius: 10px; transition: box-shadow 0.2s ease, border-color 0.2s ease; }
  .faq__item[open] { border-color: var(--color-ink); box-shadow: var(--shadow-card); }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    font: 500 1.15rem/1.35 var(--font-display);
    letter-spacing: 0.01em;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 6px;
    background: var(--color-paper-200);
    color: var(--color-ink);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .faq__item[open] .faq__icon { transform: rotate(45deg); background: var(--color-accent); color: var(--color-on-accent); }
  .faq__item p { margin: 0; padding: 0 1.35rem 1.35rem; color: var(--color-muted); }
</style>
