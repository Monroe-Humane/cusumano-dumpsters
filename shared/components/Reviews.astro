---
// Customer review quotes with the overall Google rating. Quotes are excerpts of real
// Google reviews (see each site's data/site.json → reviews), attributed by first name and initial.
import SectionHead from './SectionHead.astro';

interface Props {
  reviews: {
    rating: string;
    count: number;
    url: string;
    items: { quote: string; name: string; project: string }[];
  };
  title?: string;
}
const { reviews, title = 'What our customers say' } = Astro.props;
---
<section class="ui-section" id="reviews" aria-labelledby="reviews-title">
  <div class="ui-container">
    <div class="rev__head">
      <SectionHead id="reviews-title" eyebrow="Reviews" title={title} />
      <a class="rev__score" href={reviews.url} target="_blank" rel="noopener noreferrer">
        <span class="rev__stars" aria-hidden="true">★★★★★</span>
        <span><strong>{reviews.rating}</strong> on Google</span>
        <span class="rev__count">{reviews.count} reviews →</span>
      </a>
    </div>

    <ul class="rev__grid">
      {reviews.items.map((r) => (
        <li class="ui-card rev__card">
          <span class="rev__stars" aria-label="5 out of 5 stars">★★★★★</span>
          <blockquote>“{r.quote}”</blockquote>
          <p class="rev__who"><strong>{r.name}</strong> · {r.project}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rev__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem 2rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .rev__head :global(.ui-section-head) { margin-bottom: 0; }
  .rev__score {
    display: grid;
    justify-items: start;
    gap: 0.1rem;
    padding: 0.9rem 1.2rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
    background: #fff;
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: var(--shadow-card);
  }
  .rev__score strong { font: 800 1.6rem/1 var(--font-display); }
  .rev__score span:not(.rev__stars) { font-family: var(--font-display); font-weight: 600; }
  .rev__count { font-size: 0.9rem; color: var(--color-primary); }
  .rev__score:hover .rev__count { text-decoration: underline; }
  /* Gold that still reads on white (decorative; the numbers carry the meaning). */
  .rev__stars { color: #d97706; letter-spacing: 0.1em; font-size: 1.05rem; }

  .rev__grid { display: grid; gap: 1.25rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 700px) { .rev__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .rev__grid { grid-template-columns: repeat(3, 1fr); } }
  .rev__card { gap: 0.75rem; }
  .rev__card blockquote { margin: 0; font-size: 1.05rem; line-height: 1.6; color: var(--color-ink); }
  .rev__who { margin: auto 0 0 !important; padding-top: 0.75rem; border-top: 1px solid var(--color-line); font-size: 0.95rem; }
  .rev__who strong { color: var(--color-ink); }
</style>
