---
// Customer review quotes with the overall Google rating. Quotes are excerpts of real
// Google reviews (see each site's data/site.json → reviews), attributed by first name and initial.
import SectionHead from './SectionHead.astro';

interface Props {
  reviews: {
    rating: string;
    count: number;
    url: string;
    items: { quote: string; name: string; project: string }[];
  };
  title?: string;
}
const { reviews, title = 'What our customers say' } = Astro.props;
const initials = (name: string) => name.replace(/[^A-Za-z ]/g, '').split(' ').map((w) => w[0]).join('').slice(0, 2);
---
<section class="ui-section ui-section--tint" id="reviews" aria-labelledby="reviews-title">
  <div class="ui-container">
    <div class="rev__head">
      <SectionHead id="reviews-title" eyebrow="Reviews" title={title} />
      <a class="rev__score" href={reviews.url} target="_blank" rel="noopener noreferrer">
        <strong>{reviews.rating}</strong>
        <span class="rev__score-text">
          <span class="rev__stars" aria-hidden="true">★★★★★</span>
          <span>{reviews.count} Google reviews →</span>
        </span>
      </a>
    </div>

    <ul class="rev__grid">
      {reviews.items.map((r) => (
        <li class="rev__card">
          <span class="rev__mark" aria-hidden="true">“</span>
          <span class="rev__stars" aria-label="5 out of 5 stars">★★★★★</span>
          <blockquote>{r.quote}</blockquote>
          <p class="rev__who">
            <span class="rev__avatar" aria-hidden="true">{initials(r.name)}</span>
            <span><strong>{r.name}</strong><small>{r.project}</small></span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rev__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.25rem 2rem; margin-bottom: clamp(2.25rem, 5vw, 3.5rem); }
  .rev__head :global(.ui-section-head) { margin-bottom: 0; }
  .rev__score {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-card);
    background: var(--color-dark);
    color: #fff;
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition: transform 0.2s ease;
  }
  .rev__score:hover { transform: translateY(-2px); }
  .rev__score strong { font: 700 2.6rem/1 var(--font-display); color: var(--color-accent); }
  .rev__score-text { display: grid; gap: 0.15rem; font: 500 0.88rem/1.3 var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; }
  .rev__stars { color: #e8a400; letter-spacing: 0.12em; font-size: 1rem; }
  .rev__score .rev__stars { color: var(--color-accent); }

  .rev__grid { display: grid; gap: 1.25rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 700px) { .rev__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .rev__grid { grid-template-columns: repeat(3, 1fr); } }
  .rev__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #fff;
    box-shadow: var(--shadow-card);
  }
  .rev__mark {
    position: absolute;
    top: -1.6rem;
    right: 0.75rem;
    font: 700 9rem/1 Georgia, serif;
    color: var(--color-accent);
    opacity: 0.35;
    pointer-events: none;
  }
  .rev__card blockquote { position: relative; margin: 0; font-size: 1.08rem; line-height: 1.6; color: var(--color-ink); }
  .rev__who { display: flex; align-items: center; gap: 0.75rem; margin: auto 0 0 !important; padding-top: 1rem; border-top: 1px solid var(--color-line); }
  .rev__who > span:last-child { display: grid; line-height: 1.25; }
  .rev__who strong { font: 600 1rem/1.2 var(--font-display); letter-spacing: 0.04em; text-transform: uppercase; }
  .rev__who small { font-size: 0.9rem; color: var(--color-muted); }
  .rev__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--color-dark);
    color: var(--color-accent);
    font: 600 1rem/1 var(--font-display);
  }
</style>
