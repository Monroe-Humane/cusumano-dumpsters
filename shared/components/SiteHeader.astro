---
// Sticky header with phone menu, shared by both sites. Each site passes its own name,
// links and logo mark (default slot).
import Icon from './Icon.astro';

interface Props {
  /** Big wordmark, e.g. "Cusumano". */
  name: string;
  /** Small line under it, e.g. "Home Improvements · Since 1974". */
  sub: string;
  /** Full business name, shown as the logo link's tooltip. */
  label: string;
  links: { href: string; label: string }[];
  phone: string;
  phoneTel: string;
  /** Extra button shown at the bottom of the phone menu. */
  menuCta: { href: string; label: string };
}
const { name, sub, label, links, phone, phoneTel, menuCta } = Astro.props;
---
<header class="site-header" data-header>
  <div class="ui-container site-header__bar">
    <a href="/#top" class="brand" title={`${label}: back to top`}>
      <span class="brand__mark" aria-hidden="true">
        <slot />
      </span>
      <span class="brand__text">
        <span class="brand__name">{name}</span>
        <span class="brand__sub">{sub}</span>
      </span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <a class="ui-btn ui-btn--accent site-nav__quote" href={menuCta.href}>{menuCta.label}</a>
    </nav>

    <div class="site-header__actions">
      <a class="ui-btn ui-btn--accent ui-btn--sm site-header__call" href={phoneTel}>
        <Icon name="phone" size={18} />
        <span class="hidden sm:inline">{phone}</span>
        <span class="sm:hidden">Call</span>
      </a>
      <button type="button" class="menu-btn" aria-controls="site-nav" aria-expanded="false" data-menu-btn>
        <span class="sr-only">Menu</span>
        <span class="menu-btn__open"><Icon name="menu" size={24} /></span>
        <span class="menu-btn__close"><Icon name="close" size={24} /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(22 24 27 / 0.96);
    backdrop-filter: saturate(1.3) blur(10px);
    color: var(--color-on-dark);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
    transition: box-shadow 0.2s ease;
  }
  .site-header.is-scrolled { box-shadow: 0 10px 30px rgb(0 0 0 / 0.25); }
  .site-header__bar { display: flex; align-items: center; gap: 1.25rem; min-height: 72px; }

  .brand { display: flex; align-items: center; gap: 0.75rem; color: #fff; text-decoration: none; margin-right: auto; }
  .brand__mark { display: flex; flex: none; }
  .brand__mark :global(img), .brand__mark :global(svg) { display: block; height: 46px; width: auto; }
  .brand__text { display: grid; line-height: 1; }
  .brand__name { font: 700 1.55rem/1 var(--font-display); letter-spacing: 0.04em; text-transform: uppercase; }
  .brand__sub { margin-top: 0.2rem; white-space: nowrap; font: 500 0.74rem/1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent); }

  .site-nav ul { display: flex; gap: 0.15rem; margin: 0; padding: 0; list-style: none; }
  .site-nav a:not(.ui-btn) {
    position: relative;
    display: block;
    padding: 0.55rem 0.7rem;
    color: var(--color-on-dark);
    font: 500 0.98rem/1.2 var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .site-nav a:not(.ui-btn)::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.2rem;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }
  .site-nav a:not(.ui-btn):hover { color: #fff; }
  .site-nav a:not(.ui-btn):hover::after { transform: scaleX(1); }
  .site-nav__quote { display: none; }
  .site-header__actions { display: flex; flex: none; align-items: center; gap: 0.6rem; }
  .site-header__actions .ui-btn { white-space: nowrap; box-shadow: none; }

  .menu-btn {
    display: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1.5px solid rgb(255 255 255 / 0.25);
    border-radius: 8px;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
  .menu-btn__close { display: none; }
  .menu-btn[aria-expanded='true'] .menu-btn__open { display: none; }
  .menu-btn[aria-expanded='true'] .menu-btn__close { display: flex; }
  .menu-btn__open { display: flex; }

  @media (min-width: 1240px) {
    .site-nav { display: flex; flex: none; align-items: center; }
    .site-nav a:not(.ui-btn) { white-space: nowrap; }
  }
  @media (max-width: 1239px) {
    .menu-btn { display: grid; }
    .site-nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      padding: 0.5rem max(1rem, 4vw) 1.5rem;
      background: var(--color-dark);
      border-top: 1px solid rgb(255 255 255 / 0.08);
      box-shadow: 0 24px 40px rgb(0 0 0 / 0.35);
    }
    .site-nav.is-open { display: grid; gap: 1rem; }
    .site-nav ul { flex-direction: column; }
    .site-nav a:not(.ui-btn) { padding: 0.95rem 0.25rem; font-size: 1.15rem; border-bottom: 1px solid rgb(255 255 255 / 0.08); }
    .site-nav a:not(.ui-btn)::after { display: none; }
    .site-nav__quote { display: inline-flex; }
  }
  @media (max-width: 480px) {
    .brand__sub { display: none; }
    .brand__mark :global(img), .brand__mark :global(svg) { height: 40px; }
    .brand__name { font-size: 1.35rem; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const nav = document.getElementById('site-nav');

  if (header) {
    const setHeight = () => document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    // Measure after first paint so reading the height doesn't force an extra layout during load.
    requestAnimationFrame(() => {
      setHeight();
      onScroll();
    });
    window.addEventListener('resize', setHeight, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (btn && nav) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
